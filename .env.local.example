# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phone verification (SMS OTP at signup) — required for "register with phone".
# Same Twilio account used for admin SMS broadcasts.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Server-side pepper mixed into hashed OTP codes. Use a long random string.
OTP_PEPPER=change-me-to-a-long-random-secret

# ─── Online giving (Stripe) ─────────────────────────────────────────────────
# The giving rail is fully built and stays DORMANT until these are set: with no
# STRIPE_SECRET_KEY, /give records a giving intent for the office to follow up.
# Set both to activate real card donations, then REDEPLOY (env changes need a
# fresh deploy to take effect). We use Stripe-hosted Checkout, so NO publishable
# key is needed server-side (PCI SAQ-A). Server-only — never NEXT_PUBLIC_*.
#
# STRIPE_SECRET_KEY=sk_test_...        # sk_test_ while testing, sk_live_ to go live
# STRIPE_WEBHOOK_SECRET=whsec_...      # from the webhook endpoint you create in Stripe
#
# Optional — override the fee-coverage math if the church negotiates a rate
# other than Stripe's US nonprofit default (2.2% + $0.30):
# STRIPE_FEE_PERCENT=0.022             # e.g. 0.022 = 2.2%
# STRIPE_FEE_FIXED=0.30                # fixed per-transaction fee in dollars
